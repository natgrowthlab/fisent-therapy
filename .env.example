# ============================================================
# FISENT — Variables de Entorno
# ============================================================
# Copiar este archivo como .env.local y ajustar los valores

# API Backend
VITE_API_URL=http://localhost:3000/api

# Vercel: la API debe usar HTTPS y soportar los endpoints descritos en
# docs/PATIENT_ACCESS_API.md. Nunca use variables VITE_ para secretos o certificados.
VITE_BASE_PATH=/

# App
VITE_APP_NAME=FisenT
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_FEATURE_PAYMENTS=true
VITE_FEATURE_HISTORY=true
VITE_FEATURE_CIE10=true

# Debug
VITE_DEBUG=false
