# ============================================================
# FISENT — Variables de Entorno
# ============================================================
# Copiar este archivo como .env.local y ajustar los valores

# API propia de Next.js. Las variables NEXT_PUBLIC_* son visibles en el navegador;
# nunca incluya aquí claves, certificados ni contraseñas.
NEXT_PUBLIC_API_URL=/api

# App
NEXT_PUBLIC_APP_NAME=FisenT
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_FEATURE_PAYMENTS=true
NEXT_PUBLIC_FEATURE_HISTORY=true
NEXT_PUBLIC_FEATURE_CIE10=true

# Debug
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_API_TIMEOUT=15000

# Neon Postgres, inyectada por la integración de Vercel Marketplace.
# Solo servidor: no anteponga NEXT_PUBLIC_.
DATABASE_URL=

# Secretos exclusivos del servidor. Configúrelos en Vercel, nunca en Git.
AUTH_SECRET=
BOOTSTRAP_TOKEN=
